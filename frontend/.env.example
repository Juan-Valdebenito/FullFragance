NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Debe ser el mismo Client ID web que GOOGLE_CLIENT_ID en backend/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
# Opcional: sólo carga AdSense cuando exista un identificador válido.
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
# Slot horizontal para el anuncio ubicado en el detalle de cada perfume.
# NEXT_PUBLIC_AD_SLOT_PRODUCT_STRIP=1234567890
# Oculta "Ingresar"/"Crear cuenta" del header (y con ello favoritos, test
# olfativo y recomendaciones, que ya se esconden solos sin sesión). Útil en
# eventos de tráfico alto (cyberday) para simplificar todo a solo catálogo
# público. El login sigue funcionando en /login para el admin.
# NEXT_PUBLIC_ACCOUNTS_ENABLED=false
