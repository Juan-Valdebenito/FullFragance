# ════════════════════════════════════════════════════════════════
# Variables de entorno — PRODUCCIÓN (Railway / Render)
# ════════════════════════════════════════════════════════════════
# Copia este archivo y completa cada valor antes de deployar.
# NUNCA subas el archivo .env real al repositorio.
# ════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# ── JWT ─────────────────────────────────────────────────────────
# Genera un secreto fuerte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_por_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1d

# ── Google OAuth ─────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# ── Administradores ──────────────────────────────────────────────
# Solo estos emails recibirán rol "admin" al registrarse.
ADMIN_EMAILS=fullfragance@gmail.com

# ── CORS ─────────────────────────────────────────────────────────
# URL exacta de tu frontend en Vercel (sin barra al final).
# Puedes agregar múltiples separados por coma.
FRONTEND_ORIGINS=https://full-fragance.vercel.app

# ── Proxy inverso ────────────────────────────────────────────────
# Railway y Render están detrás de un proxy: actívalo para rate-limit por IP real.
TRUST_PROXY=true

# ── Supabase / PostgreSQL ────────────────────────────────────────
# Obtén la DATABASE_URL en: Supabase → Settings → Database → Connection string
# Usa el formato "Session mode" (port 5432) para compatibilidad con node-postgres.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ── Scraper API Key (opcional) ───────────────────────────────────
# Protege el endpoint /api/scrapers/* en producción con una clave secreta.
# Puedes generar una: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SCRAPER_API_KEY=

# ── Overpass API (mapa de tiendas) ───────────────────────────────
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_REQUEST_TIMEOUT_MS=15000
STORE_SEARCH_RADIUS_METERS=15000
STORE_CACHE_TTL_MS=21600000
MAX_STORES_PER_CITY=30

# ── Scrapers (no usar mock en producción) ────────────────────────
SCRAPER_MOCK_PRICES=false
