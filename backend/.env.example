PORT=3000
JWT_SECRET=cambia-este-valor-por-uno-secreto-largo
JWT_EXPIRES_IN=7d
ADMIN_EMAILS=fullfragance@gmail.com
ADMIN_DEFAULT_EMAIL=fullfragance@gmail.com
ADMIN_DEFAULT_PASSWORD=123456

OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_REQUEST_TIMEOUT_MS=15000
STORE_SEARCH_RADIUS_METERS=15000
STORE_CACHE_TTL_MS=21600000
MAX_STORES_PER_CITY=30

# Catálogo obtenido desde fuentes públicas. Mantén un User-Agent identificable.
SQLITE_PATH=./data/catalog.sqlite
# Si Falabella bloquea el scraping, usa un User-Agent de navegador moderno.
FALABELLA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36
FALABELLA_MIN_DELAY_MS=1500
FALABELLA_MAX_DELAY_MS=3000
FALABELLA_REQUEST_TIMEOUT_MS=20000
# Solo para pruebas locales: lee <id-producto>.html en vez de consultar Falabella.
# FALABELLA_FIXTURE_DIR=./test/fixtures/falabella
FALABELLA_PERFUMES_URL=https://www.falabella.com/falabella-cl/collection/oferta-perfumes
# Respaldo para descubrir perfumes si la colección cambia su HTML.
FALABELLA_PDP_SITEMAP_INDEX_URL=https://www.falabella.com/static/site/sitemaps/pdp/pdp_cl_FA_COM-index.xml
FALABELLA_SITEMAP_FILES_TO_SCAN=8
RIPLEY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36
RIPLEY_MIN_DELAY_MS=1200
RIPLEY_MAX_DELAY_MS=2500
RIPLEY_REQUEST_TIMEOUT_MS=20000
# Solo para pruebas locales: lee <id-producto>.html en vez de consultar Ripley.
# RIPLEY_FIXTURE_DIR=./test/fixtures/ripley
RIPLEY_PERFUMES_URL=https://simple.ripley.cl/belleza/perfumeria?source=menu&s=mdco
# En producción protege la ruta de sincronización con una clave de servidor.
SCRAPER_API_KEY=
# Solo para desarrollo: si Falabella bloquea el detalle, guarda precios demo marcados como mock.
SCRAPER_MOCK_PRICES=true
